<Window x:Class="LevelUpAccrue.Dialogs.AddPersonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加人员"
        Width="420"
        MinWidth="420"
        MinHeight="240"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="添加人员" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="姓名" Margin="0,16,0,7" Foreground="{StaticResource MutedBrush}" />
        <TextBox x:Name="NameBox" Grid.Row="2" MaxLength="40" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Width="82" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="添加" Width="82" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
