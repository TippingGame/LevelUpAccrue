<Window x:Class="LevelUpAccrue.Dialogs.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认导入"
        Width="500"
        Height="500"
        MinHeight="440"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="确认导入" FontSize="19" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Background="#F6F8F9" CornerRadius="5" Padding="12" Margin="0,16,0,12">
            <StackPanel>
                <TextBlock Text="文件中的金额表示" FontWeight="SemiBold" />
                <RadioButton x:Name="CumulativeMode" Content="本期累计金额" IsChecked="True" Margin="0,10,0,0" GroupName="AmountMode" />
                <RadioButton x:Name="IncrementMode" Content="本次新增金额（加到当前累计）" Margin="0,8,0,0" GroupName="AmountMode" />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="38" ColumnHeaderHeight="36">
            <DataGrid.Columns>
                <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="金额" Binding="{Binding Amount, StringFormat=N2}" Width="110" />
                <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="170" />
            </DataGrid.Columns>
        </DataGrid>

        <CheckBox x:Name="MarkReimbursedBox" Grid.Row="3" Content="导入后直接标记为已报销" Margin="0,14,0,14" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="82" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="导入" Width="82" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
