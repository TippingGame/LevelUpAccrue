<Window x:Class="LevelUpAccrue.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LevelUpAccrue.Converters"
        Title="增量记账"
        Icon="Assets/AppIcon.png"
        Width="1380"
        Height="840"
        MinWidth="1120"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <conv:DeltaBrushConverter x:Key="DeltaBrushConverter" />
        <conv:BoolStatusBrushConverter x:Key="BoolStatusBrushConverter" />
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter" />
        <conv:PositiveCountToVisibilityConverter x:Key="PositiveCountToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="104" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="增量记账" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="本地账本" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,8,0" Click="ImportTxt_Click" ToolTip="导入文本账单">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B5;" Margin="0,0,7,0" />
                            <TextBlock Text="导入 TXT" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,8,0" Click="Backup_Click" ToolTip="导出完整 JSON 备份">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74E;" Margin="0,0,7,0" />
                            <TextBlock Text="备份" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,8,0" Click="Restore_Click" ToolTip="从 JSON 备份恢复">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE777;" Margin="0,0,7,0" />
                            <TextBlock Text="恢复" />
                        </StackPanel>
                    </Button>
                    <Button Width="36" Padding="0" Click="OpenDataFolder_Click" ToolTip="打开数据文件夹">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE838;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="本期新增"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   LineHeight="18"
                                   LineStackingStrategy="BlockLineHeight" />
                        <TextBlock Text="{Binding PeriodTotal, StringFormat=¥ {0:N2}}"
                                   Margin="0,2,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   LineHeight="30"
                                   LineStackingStrategy="BlockLineHeight" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="8" Height="44" Background="{StaticResource BlueBrush}" CornerRadius="4" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="已报销"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   LineHeight="18"
                                   LineStackingStrategy="BlockLineHeight" />
                        <TextBlock Text="{Binding ReimbursedTotal, StringFormat=¥ {0:N2}}"
                                   Margin="0,2,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   LineHeight="30"
                                   LineStackingStrategy="BlockLineHeight" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="8" Height="44" Background="{StaticResource PrimaryBrush}" CornerRadius="4" />
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="待报销"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   LineHeight="18"
                                   LineStackingStrategy="BlockLineHeight" />
                        <TextBlock Text="{Binding PendingTotal, StringFormat=¥ {0:N2}}"
                                   Margin="0,2,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBrush}"
                                   LineHeight="30"
                                   LineStackingStrategy="BlockLineHeight" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="8" Height="44" Background="{StaticResource WarningBrush}" CornerRadius="4" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F8FAFB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="14,14,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="86" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Top">
                        <TextBlock Text="账期" FontWeight="SemiBold" FontSize="14" />
                        <Button Margin="0,10,0,0" Style="{StaticResource PrimaryButton}" Click="NewPeriod_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" Margin="0,0,7,0" />
                                <TextBlock Text="新建账期" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Periods}"
                             SelectedItem="{Binding SelectedPeriod}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="11,10" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#EDF2F4" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#DCEDE5" />
                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE787;" Margin="0,0,9,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="3">
                        <Separator Margin="0,4,0,10" />
                        <Button Style="{StaticResource DangerButton}" Click="DeletePeriod_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" Margin="0,0,7,0" />
                                <TextBlock Text="删除当前账期" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PeriodCaption}" FontWeight="SemiBold" FontSize="17" />
                        <TextBlock Text="累计金额可直接编辑" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Margin="0,0,8,0" Click="AddPerson_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" Margin="0,0,6,0" />
                                <TextBlock Text="添加人员" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Click="DeletePerson_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" Margin="0,0,6,0" />
                                <TextBlock Text="删除人员" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,3,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="145" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,5,8,5" />
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE721;" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <ComboBox Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" />
                    <CheckBox Grid.Column="2" Margin="14,0,0,0" Content="仅看有变化" IsChecked="{Binding OnlyChanged}" />
                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}">
                        <Run Text="共 " /><Run Text="{Binding PeopleCount, Mode=OneWay}" /><Run Text=" 人" />
                    </TextBlock>
                </Grid>

                <Grid Grid.Row="2">
                    <DataGrid x:Name="EntriesGrid"
                              ItemsSource="{Binding EntriesView}"
                              SelectedItem="{Binding SelectedEntry}"
                              AutoGenerateColumns="False"
                              IsSynchronizedWithCurrentItem="False"
                              FrozenColumnCount="2"
                              CellEditEnding="EntriesGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="预览" Width="58">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsPreviewSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="105" IsReadOnly="True" />
                            <DataGridTextColumn Header="上期累计" Binding="{Binding PreviousAmount, StringFormat=N2}" Width="96" IsReadOnly="True" />
                            <DataGridTextColumn Header="本期累计"
                                                Binding="{Binding CurrentAmount, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat=N2}"
                                                Width="104" />
                            <DataGridTemplateColumn Header="本期新增" Width="98" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Delta, StringFormat={}{0:+0.00;-0.00;0.00}}"
                                                   Foreground="{Binding Delta, Converter={StaticResource DeltaBrushConverter}}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="已报销" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsReimbursed}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="状态" Width="76" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{Binding IsReimbursed, Converter={StaticResource BoolStatusBrushConverter}}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="备注" Binding="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*" MinWidth="150" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Visibility="{Binding PeopleCount, Converter={StaticResource ZeroToVisibilityConverter}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE77B;" FontSize="30" Foreground="#A4ADB5" HorizontalAlignment="Center" />
                        <TextBlock Text="当前账期还没有人员" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="16,14,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="金额预览" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" FontSize="11">
                                <Run Text="已选 " /><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=" 人" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button MinHeight="30" Padding="9,4" Margin="0,0,5,0" Click="SelectAll_Click" ToolTip="选择当前筛选结果中的所有人员">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B3;" Margin="0,0,5,0" />
                                    <TextBlock Text="全选" />
                                </StackPanel>
                            </Button>
                            <Button MinHeight="30" Padding="9,4" Click="ClearSelection_Click" ToolTip="取消所有人员的预览选择">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE894;" Margin="0,0,5,0" />
                                    <TextBlock Text="取消全选" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="#F6F8F9" CornerRadius="5" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="合计" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedTotal, StringFormat=¥ {0:N2}}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <TextBox Text="{Binding PreviewText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 Padding="12"
                                 FontFamily="Microsoft YaHei UI"
                                 Background="#FBFCFD" />
                        <StackPanel Visibility="{Binding SelectedCount, Converter={StaticResource ZeroToVisibilityConverter}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8FD;" FontSize="30" Foreground="#A4ADB5" HorizontalAlignment="Center" />
                            <TextBlock Text="勾选人员后在此预览" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Click="MarkSelectedPaid_Click" ToolTip="将预览中的人员标记为已报销">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE73E;" Margin="0,0,6,0" />
                                    <TextBlock Text="标为已报销" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Click="MarkSelectedPending_Click" ToolTip="将预览中的人员恢复为待报销">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" Margin="0,0,6,0" />
                                    <TextBlock Text="恢复待报销" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Click="CopyPreview_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8C8;" Margin="0,0,6,0" />
                                    <TextBlock Text="复制清单" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="ExportPreview_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE898;" Margin="0,0,6,0" />
                                    <TextBlock Text="导出 TXT" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#EEF2F4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="金额单位：元" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
